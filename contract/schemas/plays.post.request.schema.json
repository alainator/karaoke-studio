{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:encore-studio:contract:plays.post.request.schema.json",
  "title": "POST /api/encore/plays",
  "type": "object",
  "required": [
    "plays"
  ],
  "properties": {
    "plays": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pid",
          "id",
          "base",
          "at",
          "seconds",
          "result",
          "singers",
          "style",
          "party"
        ],
        "properties": {
          "pid": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "description": "A UUID made by Encore (lowercase, as Python's str(uuid4()))."
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "base": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "integer",
            "minimum": 0,
            "description": "When it ended."
          },
          "seconds": {
            "type": "integer",
            "minimum": 0,
            "description": "Video position reached (finished: the length)."
          },
          "result": {
            "enum": [
              "finished",
              "skipped",
              "stopped"
            ]
          },
          "singers": {
            "type": "integer",
            "minimum": 1
          },
          "style": {
            "type": [
              "string",
              "null"
            ],
            "description": "The lyric mode shown (both, original, romaji, kana) or null (the song's one plain .ass)."
          },
          "party": {
            "type": "string",
            "maxLength": 80
          },
          "uid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Optional, for user profiles (§2.6, planned): the profile uuid of the person, when a user (not a guest) did it."
          },
          "guide": {
            "enum": [
              "off",
              "low",
              "medium",
              "full"
            ],
            "description": "Optional: the guide vocals level it was sung with (catalog vocals); left out when the song had none."
          },
          "score": {
            "$ref": "#/$defs/score",
            "description": "Optional (added 2026-11-20): the singing score, when the play was scored (the same object as on history events, §2.6)."
          }
        }
      },
      "minItems": 1,
      "maxItems": 200
    }
  },
  "$defs": {
    "score": {
      "type": "object",
      "required": [
        "v",
        "difficulty",
        "points",
        "pitch",
        "timing",
        "acc",
        "grade",
        "max_combo"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "difficulty": {
          "enum": [
            "easy",
            "normal",
            "hard",
            "expert"
          ]
        },
        "points": {
          "type": "integer",
          "minimum": 0
        },
        "pitch": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "timing": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "words": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Optional: the words part (§2.9); left out when the words weren't scored."
        },
        "acc": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "grade": {
          "enum": [
            "AAA",
            "AA",
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "max_combo": {
          "type": "integer",
          "minimum": 0
        },
        "partial": {
          "type": "boolean",
          "description": "Optional: true when the song was skipped or stopped before its end."
        }
      },
      "description": "The singing score (added 2026-11-20; §2.4, §2.6). The Studio stores it and never needs it."
    }
  }
}
