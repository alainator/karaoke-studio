{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:encore-studio:contract:requests.post.request.schema.json",
  "title": "POST /api/encore/requests",
  "type": "object",
  "required": [
    "rid",
    "artist",
    "title",
    "note",
    "by",
    "party",
    "at"
  ],
  "properties": {
    "rid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "A UUID made by Encore (lowercase, as Python's str(uuid4()))."
    },
    "artist": {
      "type": "string",
      "maxLength": 120,
      "description": "May be empty (they didn't know)."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "note": {
      "type": "string",
      "maxLength": 200
    },
    "by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "party": {
      "type": "string",
      "maxLength": 80
    },
    "at": {
      "type": "integer",
      "minimum": 0,
      "description": "Unix time, whole seconds."
    },
    "uid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Optional, for user profiles (§2.6, planned): the profile uuid of the person, when a user (not a guest) did it."
    },
    "auto": {
      "type": "boolean",
      "description": "§2.2b party auto-make (reserved; built later)."
    },
    "queue": {
      "type": "object",
      "required": [
        "eid"
      ],
      "properties": {
        "eid": {
          "type": "string",
          "minLength": 1
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Optional, for user profiles (§2.6, planned): the profile uuid of the person, when a user (not a guest) did it."
        }
      },
      "description": "§2.2b: the guest is already queued with a placeholder (Encore's queue entry id)."
    }
  }
}
