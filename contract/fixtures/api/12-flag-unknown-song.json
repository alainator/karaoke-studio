{
  "name": "flag-unknown-song",
  "about": "A song Encore found by scanning the folders (an 'f-' id), which the Studio doesn't know by its base either.",
  "request": {
    "method": "POST",
    "path": "/api/encore/flags",
    "headers": {
      "Authorization": "Bearer <token from pairing>"
    },
    "body": {
      "fid": "2c3d4e5f-6a7b-4c8d-8e9f-1a2b3c4d5e6f",
      "id": "f-0123456789ab",
      "base": "Someone - Something (Music Video)",
      "t": 40.0,
      "line": null,
      "kind": "early",
      "note": "",
      "by": "Jo",
      "party": "Friday at Ken's",
      "at": 1794399780
    },
    "schema": "flags.post.request.schema.json"
  },
  "response": {
    "status": 200,
    "headers": {},
    "body": {
      "fid": "2c3d4e5f-6a7b-4c8d-8e9f-1a2b3c4d5e6f",
      "status": "unknown_song"
    },
    "schema": "flags.post.response.schema.json"
  }
}
