{
  "name": "profiles-sync-delete",
  "about": "§2.6: the singer deletes their profile on the home Encore: a tombstone. The Studio erases everything of that uid (also the uid on requests, flags and plays) and keeps only the tombstone.",
  "request": {
    "method": "POST",
    "path": "/api/encore/profiles/sync",
    "headers": {
      "Authorization": "Bearer <token from pairing>"
    },
    "body": {
      "player": "8b9c0d1e-2f3a-4b4c-9d5e-6f7a8b9c0d1e",
      "since": "s4",
      "events": [
        {
          "eid": "e6c1f6de-72e1-5184-9f2e-8fdfe4ff93d5",
          "stream": "profile",
          "uid": "7a8b9c0d-1e2f-4a3b-8c4d-5e6f7a8b9c0d",
          "at": 1794486120.0,
          "deleted": true
        }
      ]
    },
    "schema": "profiles.sync.request.schema.json"
  },
  "response": {
    "status": 200,
    "headers": {},
    "body": {
      "cursor": "s5",
      "events": []
    },
    "schema": "profiles.sync.response.schema.json"
  }
}
