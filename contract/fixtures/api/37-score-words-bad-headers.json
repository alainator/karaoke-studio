{
  "name": "score-words-bad-headers",
  "about": "§2.9: a header missing or wrong (here X-Encore-Start): 422, before the body is read.",
  "request": {
    "method": "POST",
    "path": "/api/encore/score-words",
    "headers": {
      "Content-Type": "audio/ogg",
      "X-Encore-Song": "20261101-120000-nova-lane-paper-lanterns",
      "X-Encore-Base": "Nova Lane - Paper Lanterns (Music Video)",
      "X-Encore-Rate": "1.0",
      "X-Encore-Lines": "1,2",
      "Authorization": "Bearer <token from pairing>"
    },
    "body": {
      "$file": "audio/sung.ogg"
    },
    "schema": null,
    "headers_schema": "score-words.post.headers.schema.json"
  },
  "response": {
    "status": 422,
    "headers": {},
    "body": {
      "error": "X-Encore-Start: a number from -60 to 86400"
    },
    "schema": "error.schema.json"
  }
}
