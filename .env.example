# Karaoke Studio settings (copy to .env; chmod 600 because of the password)

# PiKaraoke's song folder; published songs go to "<library>/Music Videos/"
KARAOKE_LIBRARY=/path/to/pikaraoke-songs
#KARAOKE_MV_FOLDER=Music Videos

# PiKaraoke: where to ask for a library rescan, and its admin password if you set one
PIKARAOKE_URL=http://127.0.0.1:5555
PIKARAOKE_ADMIN_PASSWORD=
# PiKaraoke's database (pikaraoke.db), read-only, for "most sung" in the Library tab (optional)
PIKARAOKE_DB=

# the address you open the studio at (comma-separated); requests that change things must come from here
STUDIO_ORIGINS=http://127.0.0.1:5570

# folder containing the `node` binary, if it isn't already on PATH (yt-dlp needs it for YouTube)
#NODE_BIN=/home/you/.nvm/versions/node/v22.22.1/bin

# working folders (defaults: ./data/jobs, ./data/work, ./data/models)
#KARAOKE_JOBS=
#KARAOKE_WORK=
#KARAOKE_MODELS=

# optional: local Ollama server for "Check romaji with AI" (proofreads automatic Japanese romaji)
#OLLAMA_URL=http://127.0.0.1:11434
#OLLAMA_MODEL=gemma4:26b

# optional: a second PC with an NVIDIA GPU takes songs when this GPU is busy (see "GPU helper" in the README);
# set these with deploy/set-helper.py rather than by hand
#GPU_HELPER_URL=http://192.168.1.20:5580
#GPU_HELPER_NAME=gaming PC
#HELPER_TOKEN=

# don't start a job unless this much GPU memory is free (MiB)
#MIN_GPU_FREE_MIB=9000
#KARAOKE_SEPARATION_MODEL=model_bs_roformer_ep_317_sdr_12.9755.ckpt
#KARAOKE_WHISPER_MODEL=large-v3
