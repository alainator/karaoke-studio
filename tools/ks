def cmd_setup(a):
    """Store where the Studio is and this agent's key in the config folder (the key file readable only by you)."""
    d = config_dir()
    os.makedirs(d, exist_ok=True)
    if a.url:
        with open(os.path.join(d, "url"), "w", encoding="utf-8") as f:
            f.write(a.url.rstrip("/") + "\n")
        print(f"Studio address saved: {a.url.rstrip('/')}")
    if not a.no_key:
        k = getpass.getpass("Agent key (from the Studio's Agents tab; Enter keeps the current one): ").strip()
        if k:
            if not k.startswith("ksa_"):
                die("that doesn't look like an agent key (they start with ksa_)")
            p = os.path.join(d, "agent-key")
            fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                f.write(k + "\n")
            try:
                os.chmod(p, 0o600)
            except OSError:
                pass
            print(f"key saved in {p} (only you can read it)")
    global API, KEY
    API, KEY = studio_url(), agent_key()
    cmd_whoami(a)


