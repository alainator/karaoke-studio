    job = resolve(a.song)
    info = call(f"/api/jobs/{job['id']}/publish-info")
    remove = info.get("old_versions", []) if a.remove_old else []
    if info.get("old_versions") and not a.remove_old:
        print("older versions in the library (kept; --remove-old removes them): " + "; ".join(info["old_versions"]))
    r = call(f"/api/jobs/{job['id']}/publish", {"remove": remove}, timeout=300)
    print(f"published as '{r['name']}'" + (f", removed {len(r['removed'])} old version(s)" if r.get("removed") else "") + f" ({r['message']})")


def library_song(q):
    """remove-from-library's song: a studio song (its id, or a piece of a published one's name or library name) or,
    when no studio song matches, a library song by its catalog name (base)."""
    js = jobs()
    if any(j["id"] == q for j in js):
        return {"job": q}
    ql = q.lower()
    hits = [j for j in js if j.get("published") and (ql in f"{j['artist']} - {j['title']}".lower() or ql == (j.get("published_as") or "").lower())]
    exact = [j for j in hits if ql in (j["title"].lower(), f"{j['artist']} - {j['title']}".lower(), (j.get("published_as") or "").lower())]
    hits = exact if len(exact) == 1 else hits
    if len(hits) == 1:
        return {"job": hits[0]["id"]}
    if len(hits) > 1:
        die(f"'{q}' matches {len(hits)} published songs; use more of the name or the id:\n"
            + "\n".join(f"  {j['id']}  {j['artist']} - {j['title']}" for j in hits[:15]))
    return {"base": q[:-4] if q.lower().endswith(".mp4") else q}


def cmd_remove_from_library(a):
    q = library_song(a.song)
    t = call("/api/library/remove-preview?" + urllib.parse.urlencode(q))
    print(f"remove from the library: {t['song']}" + (f" (and its versions: {', '.join(t['versions'])})" if t["versions"] else ""))
    for f in t["files"]:
        print("  " + f)
    if not t["files"]:
        print("  (its files are already gone from the library folder)")
    if a.delete_job:
        if not t.get("job"):
            die("this song has no studio copy to delete (leave out --delete-job)")
        print(f"and delete the studio copy too: {t['job']}")
    elif t.get("studio"):
        print("the studio copy stays (ks publish puts it back)")
    if not a.yes:
        if not sys.stdin.isatty():
            die("nothing removed: add --yes to remove without asking")
        if input("Remove? [y/N] ").strip().lower() not in ("y", "yes"):
            die("nothing removed")
    r = call("/api/library/remove", dict(q, delete_job=bool(a.delete_job)), timeout=300)
    print(r["message"])


def cmd_refresh_library(a):
    r = call("/api/library/refresh", {}, timeout=300)
    print(r["message"])
    for k in ("added", "removed", "changed"):
        if r[k]:
            print(f"{k} ({len(r[k])}): " + "; ".join(r[k]))
    if r.get("unlisted"):
        print(f"in Music Videos but not in the catalog ({len(r['unlisted'])}: no studio song published them, players don't "
              "get them): " + "; ".join(r["unlisted"]))


def cmd_simple(path, body=None, label=""):
    def run(a):
        job = resolve(a.song)
        if path == "DELETE":
            call(f"/api/jobs/{job['id']}", method="DELETE")
        else:
            call(f"/api/jobs/{job['id']}/{path}", body if body is not None else {})
        print(f"{label}: {job['artist']} - {job['title']}")
    return run


