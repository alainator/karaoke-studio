def lrclib(path):
    for k in range(4):
        try:
            req = urllib.request.Request("https://lrclib.net" + path, headers={"User-Agent": "karaoke-studio-ks/1.0 (+https://github.com/alainator/karaoke-studio)"})
            return json.load(urllib.request.urlopen(req, timeout=30))
        except urllib.error.HTTPError as e:
            if e.code == 429 and k < 3:
                time.sleep(5 * (k + 1)); continue
            if e.code == 404:
                return None
            raise


