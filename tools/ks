def cmd_word(a):
    """One word's start and/or end (e.g. a held last note), the rest of the line untouched; it can't cross its
    neighbours in the line."""
    job = resolve(a.song)

    def ch(lines, off):
        i = line_no(lines, a.n)
        l = lines[i]
        ws = l["words"]
        m = re.fullmatch(r"(\d+)(?:\.(\d+))?", a.w)
        if not m:
            die("W is a word number (3) or a word's piece (3.2)")
        k = int(m.group(1)) - 1
        if not 0 <= k < len(ws):
            die(f"line {a.n} has words 1-{len(ws)}")
        syl = syl_of(l)
        pcs = syl[k]
        if m.group(2):  # one piece of a word sung in syllables
            if not pcs:
                die(f'word {k + 1} isn\'t split: ks syllables SONG {a.n} {k + 1} "tra|ge|dies" first')
            p = int(m.group(2)) - 1
            if not 0 <= p < len(pcs):
                die(f"word {k + 1} has pieces {k + 1}.1-{k + 1}.{len(pcs)}")
            s0 = parse_t(a.start) - off if a.start is not None else pcs[p][0]
            e0 = parse_t(a.end) - off if a.end is not None else pcs[p][1]
            lo = pcs[p - 1][0] + PIECE_MIN if p > 0 else (ws[k - 1][1] if k > 0 else 0.0)
            hi = pcs[p + 1][1] - PIECE_MIN if p + 1 < len(pcs) else (ws[k + 1][0] if k + 1 < len(ws) else 1e9)
            if not (lo - 0.001 <= s0 and e0 <= hi + 0.001 and e0 - s0 >= PIECE_MIN - 1e-6):
                die(f"piece {a.w} has to stay between {fmt(lo + off)} and {fmt(hi + off) if hi < 1e9 else 'the end'}, "
                    f"at least {PIECE_MIN} s long")
            if p > 0:      # the boundary it shares with the piece before moves for both
                pcs[p - 1][1] = round(s0, 3) if abs(pcs[p - 1][1] - pcs[p][0]) < 0.001 else round(min(pcs[p - 1][1], s0), 3)
            if p + 1 < len(pcs):
                pcs[p + 1][0] = round(e0, 3) if abs(pcs[p + 1][0] - pcs[p][1]) < 0.001 else round(max(pcs[p + 1][0], e0), 3)
            pcs[p] = [round(s0, 3), round(e0, 3), pcs[p][2]]
            ws[k] = [pcs[0][0], pcs[-1][1], ws[k][2]]
            l["syl"] = syl   # (a ⚠ mark stays: the line's words didn't move)
            return f"line {a.n} word {k + 1} piece {p + 1} ({pcs[p][2]}) now {fmt(s0 + off)}-{fmt(e0 + off)}"
        s0 = parse_t(a.start) - off if a.start is not None else ws[k][0]
        e0 = parse_t(a.end) - off if a.end is not None else ws[k][1]
        lo = ws[k - 1][1] if k > 0 else 0.0
        hi = ws[k + 1][0] if k + 1 < len(ws) else 1e9
        if not lo - 0.001 <= s0 < e0 <= hi + 0.001:
            die(f"word {a.w} has to stay between {fmt(lo + off)} and {fmt(hi + off) if hi < 1e9 else 'the end'}, start before end")
        if pcs:  # a split word: only its first piece's start and last piece's end move (a held last syllable)
            if not (s0 < pcs[0][1] - PIECE_MIN + 1e-6 and e0 > pcs[-1][0] + PIECE_MIN - 1e-6):
                die(f"word {a.w} is sung in pieces: its start has to stay before {fmt(pcs[0][1] + off)} and its end "
                    f"after {fmt(pcs[-1][0] + off)} (or time the pieces with ks word SONG N {k + 1}.P)")
            pcs[0][0], pcs[-1][1] = round(s0, 3), round(e0, 3)
            l["syl"] = syl
        ws[k] = [round(s0, 3), round(e0, 3), ws[k][2]]
        lines[i]["weak"] = False
        return f"line {a.n} word {a.w} now {fmt(s0 + off)}-{fmt(e0 + off)}"
    edit(job, ch, f"word {a.w} of line {a.n}")


def cmd_text(a):
    job = resolve(a.song)

    def ch(lines, off):
        i = line_no(lines, a.n)
        l = lines[i]
        typed = typed_words(a.words)
        words = [w for w, _ in typed]
        if not words:
            die("give the words (to remove a line: ks delete-line)")
        old = syl_of(l)
        if len(words) == len(l["words"]):
            l["words"] = [[w[0], w[1], t] for w, t in zip(l["words"], words)]
            l["syl"] = [o if o and "".join(p[2] for p in o) == w[2] else None for o, w in zip(old, l["words"])]
        else:
            a0, b0 = span(l)
            l["words"] = spread(words, a0, b0)
            l["syl"] = None
            if l.get("wwho"):
                l["wwho"] = None
                print("(its words changed: per-word singers were cleared, as in the web app)")
        for j, (_, pieces) in enumerate(typed):
            set_pieces(l, j, pieces)
        return f"line {a.n} text changed ({len(words)} words)"
    edit(job, ch, f"text of line {a.n}")


def cmd_split(a):
    job = resolve(a.song)

    def ch(lines, off):
        i = line_no(lines, a.n)
        l, j = lines[i], int(a.w) - 1
        if not 1 <= j < len(l["words"]):
            die(f"split before word 2-{len(l['words'])}")
        sy = syl_of(l)
        second = dict(l, words=l["words"][j:], wwho=l["wwho"][j:] if l.get("wwho") else None, weak=False,
                      syl=sy[j:] if any(sy[j:]) else None)
        l["words"], l["wwho"], l["weak"] = l["words"][:j], (l["wwho"][:j] if l.get("wwho") else None), False
        l["syl"] = sy[:j] if any(sy[:j]) else None
        lines.insert(i + 1, second)
        return f"line {a.n} split before word {a.w}"
    edit(job, ch, f"split line {a.n}")


def cmd_join(a):
    job = resolve(a.song)

    def ch(lines, off):
        i = line_no(lines, a.n)
        if i + 1 >= len(lines):
            die("that's the last line")
        l, nx = lines[i], lines[i + 1]
        ww = (l.get("wwho") or [None] * len(l["words"])) + (nx.get("wwho") or [None] * len(nx["words"])) if (l.get("wwho") or nx.get("wwho")) else None
        both = sorted(zip(l["words"] + nx["words"], ww or [None] * (len(l["words"]) + len(nx["words"])), syl_of(l) + syl_of(nx)),
                      key=lambda x: x[0][0])
        l["words"], l["wwho"], l["weak"] = [x[0] for x in both], ([x[1] for x in both] if ww else None), False
        l["syl"] = [x[2] for x in both] if any(x[2] for x in both) else None
        del lines[i + 1]
        return f"lines {a.n} and {int(a.n) + 1} joined"
    edit(job, ch, f"join line {a.n}")


