#!/usr/bin/env python3
"""ks: Karaoke Studio from the command line, for agents (and anyone in a terminal). AGENTS.md says how to use it well.

Everything the web app's song page and editor do, through the same API, so edits behave exactly as there:
moving or stretching a line clears its ⚠, the subtitles are rebuilt, every edit is signed with who made it and can
be undone (ks undo, or Undo in the editor), and nothing is saved if the song was edited elsewhere since ks read it.
What an agent may do is set by its key (made on the Studio's Agents tab); without a key ks acts as "ks".

  ks setup [--url URL]                    where the Studio is, and this agent's key (asked for, never shown)
  ks whoami                               who the Studio takes you for, and what your key allows
  ks status [--brief]                     studio, queue, songs with lines to fix
  ks list [--fix] [--failed] [--q TEXT] [--limit N]
  ks show SONG                            the lines: times, ⚠ marks and why, notes, singers, text
  ks check SONG                           by ear, now: which lines sit away from where they're heard
  ks heard SONG --line N | --at T [--span S]   what the transcription heard around there
  ks look SONG --line N | --at T [--span S] [--align]   picture: vocals spectrogram, melody, line blocks, heard words
                                          (PNG); --align adds where the aligner puts line N's words
  ks align SONG N [--json] | ks align SONG --window START END   where the forced aligner puts line N when it hears it
                                          together with the line before (or every line in a stretch): its start vs
                                          now, per word; nothing is saved
  ks frame SONG --line N | --at T         the video at that moment with the lyrics on screen (PNG)
  ks log SONG                             the end of the song's pipeline log
  ks search "Artist - Title" | LINK       videos and lyrics to choose from (a YouTube link: that video first, and the
                                          song's names read from its title)
  ks make --yt ID --lyrics ID [--source lrclib|karamoe] --artist A --title T [--gpu auto|local|remote] [--auto]
                                          (--auto: published by itself when its video check passes)
  ks import PLAYLIST-LINK | FILE | - [--make] [--gpu auto|local|remote]
                                          a YouTube playlist, or songs one per line (Artist - Title, or a video link;
                                          - reads them from stdin): the Studio picks the video and timed lyrics for
                                          each (up to 2000) and ks prints the review; --make queues the ready ones.
                                          ks import IMPORT-ID [--make] shows (and makes) an import again

  editing (times are video times, as shown: m:ss.cc or seconds; N is the line number from ks show):
  ks move SONG N (+0.8 | -1.2 | --to 1:23.40) [--ripple]   move a line (with --ripple, every later line too)
  ks stretch SONG N [--start T] [--end T]  new start and/or end; the words keep their proportions
  ks word SONG N W [--start T] [--end T]  one word's timing (e.g. a held last note), the rest of the line as is;
                                          W.P: piece P of a word sung in syllables (3.2 = word 3's second piece)
  ks syllables SONG N W "tra|ge|dies"     sing word W in pieces: they show joined, each lit at its own time (then
                                          time them with ks word SONG N W.P); "tragedies" (no |) joins it again
  ks syllables SONG --auto [--dry]        split the words the melody clearly holds or stretches over several notes
  ks text SONG N "new words"              same number of words keeps their timing, otherwise spread evenly; a |
                                          inside a word splits it into syllables (tra|ge|dies)
  ks split SONG N W                       split before word W (1-based); join SONG N joins N and N+1
  ks add SONG --start T [--end T] "words" | ks delete-line SONG N
  ks trim SONG --start T [--end T]   cut ads or an intro off the video (times in the original video; --start 0 undoes it)
  ks video SONG (--url URL | --file PATH) --mode replace|version [--name NAME] [--offset S] [--loop]
                                          someone's own video for the song (its sound and lyrics, another picture):
                                          in place of the official video, or as a named version; lined up by sound
                                          unless --offset (seconds of the song where the video's start plays)
  ks skipped SONG | ks unskip SONG K --start T [--end T]   lyric lines the studio left out; put one back where sung
  ks copy SONG N --to T                   copy a line (a repeated chorus) to another time, original row and singers too
  ks fill-orig SONG                       lines added by hand get their original-script row from an identical line
  ks note SONG N... "text" [--mark] | --clear   your view on ⚠ lines, shown with the mark and signed with your name
                                          (--mark flags an unmarked line; --clear removes your note)
  ks ok SONG N [N ...] | --all            "this line is fine": clears its ⚠ (needs a key that allows clearing marks)
  ks offset SONG SECONDS                  whole song earlier/later (-5..+5), as the timing slider
  ks reading SONG zh|yue                  Chinese songs: pinyin (Mandarin) or jyutping (Cantonese)
  ks rename SONG --artist A --title T     ks singers SONG (suggestions only, nothing saved)
  ks history SONG                         the song's undoable edits: who, what, when
  ks undo SONG [--any]                    undo the song's last edit if it was yours (--any: whoever made it)

  ks alt-lyrics SONG [--artist A --title T]   every LRCLIB copy, scored against what's heard in this video
  ks change SONG [--yt ID] [--lyrics ID] [--source lrclib|karamoe]   remake with another video and/or lyrics; the new
                                          version replaces this one once it's made
  ks remove-from-library SONG|BASE [--delete-job] [--yes]   delete a published song's files from the library (its
                                          versions' too; players drop it); the studio copy stays unless --delete-job.
                                          Lists the files and asks first unless --yes. BASE: a library song with no
                                          studio copy, by its file name without .mp4
  ks refresh-library                      rebuild the players' catalog from the library folder (files added or removed
                                          by hand) and say what changed
  publish, remove-from-library, refresh-library, reviewed, reset, remake, undo-remake, retry, delete, change, trim,
  video: only when the person asks; the Studio refuses them unless the key allows them.

Where the Studio is: STUDIO_URL, else the file `url` in the config folder (ks setup), else http://127.0.0.1:5570.
The agent key: STUDIO_AGENT_KEY, else the file named by STUDIO_AGENT_KEY_FILE, else the file `agent-key` in the config folder (~/.config/karaoke-studio/, or
$XDG_CONFIG_HOME/karaoke-studio/; on Windows %APPDATA%\\karaoke-studio\\). Pictures go to ~/.cache/karaoke-studio/ks
($KS_OUT to change it).
"""
import difflib, argparse, getpass, json, os, re, stat, sys, time, urllib.error, urllib.parse, urllib.request

VERSION = "2.0"
LATE, EARLY = 1.0, 2.5   # the studio's own tolerance (earcheck): late by more than 1 s, or more than 2.5 s early


def config_dir():
    if os.name == "nt" and os.environ.get("APPDATA"):
        return os.path.join(os.environ["APPDATA"], "karaoke-studio")
    return os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config"), "karaoke-studio")


def _read_conf(name):
    p = os.path.join(config_dir(), name)
    try:
        with open(p, encoding="utf-8") as f:
            v = f.read().strip()
    except OSError:
        return None, p
    return v or None, p


def studio_url():
    return (os.environ.get("STUDIO_URL") or _read_conf("url")[0] or "http://127.0.0.1:5570").rstrip("/")


def agent_key():
    k = os.environ.get("STUDIO_AGENT_KEY", "").strip()
    if k:
        return k
    kf = os.environ.get("STUDIO_AGENT_KEY_FILE", "").strip()
    if kf:   # a key file of its own (e.g. a benchmark sandbox's): only that one, never the config folder's
        try:
            with open(os.path.expanduser(kf), encoding="utf-8") as f:
                k = f.read().strip()
        except OSError as e:
            sys.exit(f"ks: can't read STUDIO_AGENT_KEY_FILE ({e.strerror})")
        if not k:
            sys.exit("ks: STUDIO_AGENT_KEY_FILE is empty")
        p = os.path.expanduser(kf)
    else:
        k, p = _read_conf("agent-key")
    if k and os.name != "nt":
        try:
            if os.stat(p).st_mode & (stat.S_IRWXG | stat.S_IRWXO):
                print(f"ks: warning: {p} can be read by others; chmod 600 it", file=sys.stderr)
        except OSError:
            pass
    return k


API = studio_url()
KEY = agent_key()
OUT = os.environ.get("KS_OUT") or os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(os.path.expanduser("~"), ".cache"),
                                               "karaoke-studio", "ks")


def die(msg):
    sys.exit(f"ks: {msg}")


def headers(extra=None):
    h = {"User-Agent": f"ks/{VERSION}", "Accept": "application/json"}
    if KEY:
        h["X-Studio-Agent-Key"] = KEY
    return dict(h, **(extra or {}))


def call(path, body=None, method=None, timeout=60, raw=False, with_headers=False):
    method = method or ("POST" if body is not None else "GET")
    req = urllib.request.Request(API + path, data=json.dumps(body).encode() if body is not None else None,
                                 headers=headers({"Content-Type": "application/json"}), method=method)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            data = r.read()
            if raw:
                return (data, r.headers) if with_headers else data
            return json.loads(data) if data[:1] in (b"{", b"[") else data.decode("utf-8", "replace")
    except urllib.error.HTTPError as e:
        try:
            msg = json.loads(e.read()).get("detail")
        except Exception:
            msg = e.reason
        die(f"{method} {path}: {e.code} {msg}")
    except urllib.error.URLError as e:
        die(f"the studio doesn't answer at {API} ({e.reason}); is it running? set STUDIO_URL or run ks setup")


def jobs():
    j = call("/api/jobs")
    return j if isinstance(j, list) else j["jobs"]


def resolve(q):
    """A job id, or a piece of 'artist - title' that matches one song."""
    js = jobs()
    for j in js:
        if j["id"] == q:
            return j
    ql = q.lower()
    hits = [j for j in js if ql in f"{j['artist']} - {j['title']}".lower() or ql in j["id"]]
    if len(hits) == 1:
        return hits[0]
    if not hits:
        die(f"no song matches '{q}'")
    die(f"'{q}' matches {len(hits)} songs; use more of the name or the id:\n" + "\n".join(f"  {j['id']}  {j['artist']} - {j['title']}" for j in hits[:15]))


def fmt(t):
    if t is None:
        return "  -   "
    neg = t < 0
    t = abs(t)
    return f"{'-' if neg else ''}{int(t // 60)}:{t % 60:05.2f}"


def parse_t(s):
    s = str(s).strip()
    m = re.fullmatch(r"(-?)(\d+):(\d{1,2}(?:\.\d+)?)", s)
    if m:
        v = int(m.group(2)) * 60 + float(m.group(3))
        return -v if m.group(1) else v
    try:
        return float(s)
    except ValueError:
        die(f"not a time: {s} (use m:ss.cc or seconds)")


def text_of(l):
    return " ".join(w[2] for w in l["words"])


# ---- syllables: a word sung in pieces, "syl" in the line (the Studio's syllables.py; null per unsplit word) ----
PIECE_MIN = 0.06


def syl_of(l):
    s = l.get("syl")
    return list(s) if isinstance(s, list) and len(s) == len(l["words"]) else [None] * len(l["words"])


def marked_text(l):
    """The line's text with its split words marked: tra|ge|dies."""
    return " ".join("|".join(p[2] for p in s) if s else w[2] for w, s in zip(l["words"], syl_of(l)))


def even_pieces(a, b, texts):
    w = [max(1, len(t)) for t in texts]
    t, out = a, []
    for k, (x, wi) in enumerate(zip(texts, w)):
        e = b if k == len(texts) - 1 else t + (b - a) * wi / sum(w)
        out.append([round(t, 3), round(e, 3), x])
        t = e
    return out


def set_pieces(l, j, texts):
    """Word j sung in these pieces (evenly timed, unless they're already its pieces), or whole again (None)."""
    syl, w = syl_of(l), l["words"][j]
    if texts and len(texts) >= 2:
        if "".join(texts) != w[2]:
            die(f"the pieces make {''.join(texts)!r} but the word is {w[2]!r} (change the word with ks text)")
        if not (syl[j] and [p[2] for p in syl[j]] == list(texts)):
            syl[j] = even_pieces(w[0], w[1], list(texts))
    else:
        syl[j] = None
    l["syl"] = syl if any(syl) else None


def typed_words(text):
    """Words as typed: [(word, pieces or None)]; a | inside a word splits it."""
    out = []
    for tok in text.split():
        parts = [p for p in tok.split("|") if p]
        if parts:
            out.append(("".join(parts), parts if len(parts) >= 2 else None))
    return out


def span(l):
    return l["words"][0][0], l["words"][-1][1]


def get_lines(job):
    d = call(f"/api/jobs/{job['id']}/lines")
    return d


def line_no(lines, n):
    n = int(n)
    if not 1 <= n <= len(lines):
        die(f"line {n} doesn't exist (1-{len(lines)})")
    return n - 1


# ---------------- editing: read, change, save (the studio keeps the undo copy and refuses if it changed meanwhile) ----------------
def edit(job, change, what):
    jid = job["id"]
    before_edit = call(f"/api/jobs/{jid}")["edited"]
    d = get_lines(job)
    lines, cast, off = d["lines"], d.get("cast") or [], d.get("offset") or 0.0
    old = json.loads(json.dumps(lines))
    msg = change(lines, off)
    if json.dumps(lines) == json.dumps(old):
        print("nothing changed")
        return
    call(f"/api/jobs/{jid}/lines", {"lines": lines, "cast": cast, "what": what, "if_edited": before_edit})
    print(msg or what)
    after_save(job, lines)


def after_save(job, lines):
    # the studio keeps lines in time order: a moved line can get a new number, and so can the ones it passed
    now = get_lines(job)["lines"]
    if [text_of(l) for l in now] != [text_of(l) for l in lines]:
        moved = [k for k, l in enumerate(lines) if k < len(now) and text_of(l) != text_of(now[k])]
        print(f"line numbers changed from line {moved[0] + 1 if moved else '?'} on (lines are kept in time order); "
              f"run ks show again before using line numbers")
    left = sum(1 for l in now if l.get("weak"))
    print(f"saved; {left} line{'s' if left != 1 else ''} still marked ⚠; ks undo SONG takes it back"
          + ("" if not job.get("published") else "; players have the old version until it's published again"))


def shift(l, delta):
    l["words"] = [[round(max(0.0, a + delta), 3), round(max(0.0, b + delta), 3), w] for a, b, w in l["words"]]


def scale(l, a1, b1):
    a0, b0 = span(l)
    k = (b1 - a1) / max(0.05, b0 - a0)
    l["words"] = [[round(a1 + (a - a0) * k, 3), round(a1 + (b - a0) * k, 3), w] for a, b, w in l["words"]]


def spread(texts, a, b):
    """The web editor's spread(): words share the time by their length."""
    w = [max(2, len(x)) for x in texts]
    tot, sp, t, out = sum(w), max(0.4, b - a), a, []
    for x, wi in zip(texts, w):
        dd = sp * wi / tot
        out.append([round(t, 3), round(t + dd * 0.92, 3), x])
        t += dd
    return out


def by_ear(job):
    return call(f"/api/jobs/{job['id']}/agent/check", timeout=300)


def save_png(data, name):
    os.makedirs(OUT, exist_ok=True)
    p = os.path.join(OUT, name)
    with open(p, "wb") as f:
        f.write(data)
    return p


# ---------------- commands ----------------
def cmd_status(a):
    st, js = call("/api/status"), jobs()
    run = [j for j in js if j["status"] == "running"]
    q = [j for j in js if j["status"] == "queued"]
    done = [j for j in js if j["status"] == "done"]
    fix = [j for j in done if (j.get("to_check") or 0) > 0]
    failed = [j for j in js if j["status"] == "failed"]
    g = st["gpus"]
    line = (f"Karaoke Studio: {len(done)} songs ({sum(1 for j in done if j.get('published'))} published), "
            f"{len(fix)} with lines to fix ({sum(j.get('to_check') or 0 for j in fix)} lines), {len(failed)} failed; "
            f"making: {', '.join(j['artist'] + ' - ' + j['title'] for j in run) or 'nothing'}"
            f"{f', {len(q)} queued' if q else ''}; GPU {g['local']} {st['gpu_free_gb']} GB free"
            + (f"; helper {g['helper']}: " + ("off" if not g.get("helper_online") else
               "online but on older code (it updates from GitHub, so it waits until the studio's code is pushed)"
               if g.get("helper_outdated") else "online") if g.get("helper") else ""))
    print(line)
    if not a.brief:
        print("tools: ks list --fix | ks show SONG | ks check SONG | ks look SONG --line N (see `ks -h`)")


def cmd_list(a):
    js = jobs()
    if a.fix:
        js = [j for j in js if j["status"] == "done" and (j.get("to_check") or 0) > 0]
        js.sort(key=lambda j: -(j.get("to_check") or 0))
    if a.failed:
        js = [j for j in js if j["status"] == "failed"]
    if a.q:
        ql = a.q.lower()
        js = [j for j in js if ql in f"{j['artist']} - {j['title']}".lower()]
    if a.json:   # for scripts: the same songs, as data
        out = []
        for j in js[:a.limit]:
            c = (j.get("result") or {}).get("confidence") or {}
            out.append({"id": j["id"], "artist": j["artist"], "title": j["title"], "status": j["status"], "to_check": j.get("to_check") or 0,
                        "heard": c.get("sure"), "lines": c.get("lines"), "lang": (j.get("result") or {}).get("lang") or j.get("lang"),
                        "published": bool(j.get("published")), "unpublished_changes": bool(j.get("unpublished_changes")),
                        "reviewed": bool(j.get("reviewed")), "edited": bool(j.get("edited"))})
        print(json.dumps(out, ensure_ascii=False, indent=1))
        return
    for j in js[:a.limit]:
        r = j.get("result") or {}
        c = r.get("confidence") or {}
        heard = f"{c.get('sure')}/{c.get('lines')}" if c.get("sure") is not None else ("?" if j["status"] == "done" else "")
        flags = ("P" if j.get("published") else " ") + ("*" if j.get("unpublished_changes") else " ") + ("✓" if j.get("reviewed") else " ") + ("e" if j.get("edited") else " ")
        st = j["status"] if j["status"] != "done" else f"{j.get('to_check') or 0:2} ⚠"
        print(f"{st:>9}  {heard:>7}  {(r.get('lang') or j.get('lang') or ''):3} {flags}  {j['artist'][:28]} - {j['title'][:44]}   [{j['id']}]")
    print(f"({min(len(js), a.limit)} of {len(js)}; flags: P published, * unpublished changes, ✓ checked by you, e edited)")


def cmd_show(a):
    job = resolve(a.song)
    j = call(f"/api/jobs/{job['id']}")
    r = j.get("result") or {}
    d = get_lines(job)
    off = d.get("offset") or 0.0
    c = r.get("confidence") or {}
    print(f"{j['artist']} - {j['title']}   [{j['id']}]")
    print(f"  video {j.get('yt')} | lyrics {j.get('lyrics_source')}:{j.get('lrc_id')} | lang {r.get('lang')} | {fmt(d.get('duration'))} long | "
          f"offset {off:+.2f} s | heard in place {c.get('sure')}/{c.get('lines')} | to fix {j.get('to_check')}"
          + (" | published" + (" (changes not published)" if j.get("unpublished_changes") else "") if j.get("published") else "")
          + (" | checked by you" if j.get("reviewed") else "") + (" | edited" if j.get("edited") else ""))
    vc = j.get("video_check")
    if vc:
        print("  video check: " + ("passes" if vc["ok"] else "needs a look") +
              (f" (made again automatically: {vc['retried'].get('why')})" if vc.get("retried") else "") +
              (f" | held: {j['auto_held']}" if j.get("auto_held") else ""))
        for c_ in vc["checks"]:
            print(f"    {'·' if c_.get('info') else ('✓' if c_['ok'] else '⚠')} {c_['note']}")
    if j.get("last_edit"):
        le = j["last_edit"]
        print(f"  last edited by {le.get('by')} ({le.get('kind')}) {ago(le.get('at'))}: {le.get('what') or ''}")
    if d.get("cast"):
        print("  singers: " + ", ".join(f"{i}={n}" for i, n in enumerate(d["cast"])))
    for i, l in enumerate(d["lines"]):
        a0, b0 = span(l)
        mark = "⚠" if l.get("weak") else ("✓" if l.get("ok") else " ")
        who = f" s{l['singer']}" if l.get("singer") else (f" m{','.join(map(str, l['members']))}" if l.get("members") else "")
        print(f"{i + 1:3} {mark} {fmt(a0 + off)}-{fmt(b0 + off)}{' (backing)' if l.get('backing') else ''}{who}  {marked_text(l)}")
        if l.get("orig"):
            print(f"      {l['orig']}")
        if l.get("weak") and l.get("why"):
            print(f"      ⚠ {l['why']}")
        if l.get("note"):
            print(f"      note, {l['note'].get('by')}: {l['note'].get('text')}")
    if d.get("skipped"):
        print(f"  {len(d['skipped'])} lyric lines aren't sung in this video (left out)")


def cmd_check(a):
    job = resolve(a.song)
    d = get_lines(job)
    res = by_ear(job)
    off = d.get("offset") or 0.0
    lines = d["lines"]
    known = res["known"]
    if getattr(a, "json", False):   # for scripts: each lead line's offset (s; null = not heard anywhere), its mark, the move
        rows = []
        for k, x in res["offsets"].items():
            i = int(k); l = lines[i]
            rows.append({"line": i + 1, "start": round(span(l)[0] + off, 2), "weak": bool(l.get("weak")), "ok": bool(l.get("ok")),
                         "heard_offset": x, "off": x is not None and (x < -LATE or x > EARLY)})
        print(json.dumps({"sure": res["sure"], "lead": res["lead"], "followed": bool(known), "has_heard": bool(res.get("heard_words")), "lines": rows}, indent=1))
        return
    if not res.get("heard_words"):
        die("this song has no record of what was heard (heard.json): made before the by-ear check, or on a GPU helper "
            "on older code. On the Studio's machine, deploy/check-library.py --missing-heard makes one (GPU, about 20 s "
            "a song). Until then, judge by the picture (ks look).")
    print(f"by ear (now): {res['sure']} of {res['lead']} lines heard where they sit" + ("" if known else " — the song can't be followed by ear well; judge by the picture (ks look)"))
    bad = 0
    for k, x in res["offsets"].items():
        i = int(k)
        l = lines[i]
        a0, _ = span(l)
        if x is None:
            if l.get("weak"):
                print(f"{i + 1:3} ⚠ {fmt(a0 + off)}  not heard clearly anywhere ({l.get('why') or 'marked'})")
            continue
        if x < -LATE or x > EARLY:
            bad += 1
            side = f"heard {-x:.1f} s earlier: the line lights up too late" if x < 0 else f"heard {x:.1f} s later: the line runs ahead and may leave too soon"
            print(f"{i + 1:3} {'⚠' if l.get('weak') else ' '} {fmt(a0 + off)}  {side}  → ks move SONG {i + 1} {x:+.2f}")
        elif l.get("weak"):
            print(f"{i + 1:3} ⚠ {fmt(a0 + off)}  heard in place now ({x:+.1f} s): if it looks right, ks ok SONG {i + 1}")
    if not bad:
        print("no line is heard somewhere else (beyond the studio's tolerance: 1 s late, 2.5 s early)")


# ---------------- autofix: the clear fixes only ----------------
AUTO_MAX = 15.0       # a single line moves at most this far (more is a different problem: a cut, or wrong lyrics)
SECTION_MAX = 90.0    # a run of lines off by the same amount (a section the video plays elsewhere) may move this far


def autofix_plan(res, lines):
    """The clear fixes, from the by-ear check: ⚠ lines (never ones marked fine) heard late by 1-15 s or early by more
    than the studio's 2.5 s tolerance (up to 15 s). Three or more neighbouring ⚠ lines off by about the same amount
    are one section: they move together. Returns ("section", first, last, delta) or ("line", i, delta) or None."""
    sug = []
    for k, x in res["offsets"].items():
        i = int(k); l = lines[i]
        if x is None or not l.get("weak") or l.get("ok"):
            continue
        d = abs(x)
        if (x < 0 and LATE <= d <= SECTION_MAX) or (x > 0 and EARLY < d <= SECTION_MAX):
            sug.append((i, x))
    sug.sort()
    run, best = [], None
    for i, x in sug + [(None, None)]:
        if i is not None and run and i - run[-1][0] <= 2 and abs(x - run[0][1]) <= 0.4:
            run.append((i, x)); continue
        if len(run) >= 3 and abs(run[0][1]) >= LATE and (best is None or len(run) > len(best)):
            best = run
        run = [(i, x)] if i is not None else []
    if best:
        ds = sorted(x for _, x in best)
        return ("section", best[0][0], best[-1][0], ds[len(ds) // 2])
    single = [(i, x) for i, x in sug if abs(x) <= AUTO_MAX]
    if not single:
        return None
    i, x = max(single, key=lambda s: -s[1] if s[1] < 0 else 0)   # the line that lights up latest first
    return ("line", i, x)


def cmd_autofix(a):
    """Apply the clear fixes, one at a time, checking by ear again after each (line numbers stay right)."""
    job = resolve(a.song)
    done = 0
    for _ in range(a.max):
        d = get_lines(job)
        res = by_ear(job)
        if not res.get("heard_words"):
            die("this song has no record of what was heard: nothing to go by (ks look, by the picture)")
        if res["lead"] and res["sure"] < 0.5 * res["lead"]:
            print(f"the studio couldn't follow this song by ear ({res['sure']} of {res['lead']} lines heard in place): "
                  "autofix leaves it to the picture (ks look) and you"); return
        plan = autofix_plan(res, d["lines"])
        if not plan:
            break
        if plan[0] == "section":
            _, i0, i1, x = plan
            say = f"lines {i0 + 1}-{i1 + 1} (a section heard {abs(x):.1f} s {'earlier' if x < 0 else 'later'}) {x:+.2f} s"
        else:
            _, i0, x = plan; i1 = i0
            say = f"line {i0 + 1} (heard {abs(x):.1f} s {'earlier' if x < 0 else 'later'}) {x:+.2f} s"
        if a.dry:
            print("would move", say); return
        def ch(lines, off, i0=i0, i1=i1, x=x, say=say):
            for l in lines[i0:i1 + 1]:
                shift(l, x); l["weak"] = False
            return "moved " + say
        edit(job, ch, f"autofix: {say}")
        done += 1
    print(f"autofix: {done} fix{'es' if done != 1 else ''}" + (" (ks undo SONG takes them back one by one)" if done else ": nothing clear to fix") +
          "; the rest stays marked ⚠ for a person (ks check SONG)")


def window(job, d, a):
    off = d.get("offset") or 0.0
    if a.line:
        i = line_no(d["lines"], a.line)
        a0, b0 = span(d["lines"][i])
        pad = a.span if a.span is not None else 4.0
        return a0 + off - pad, b0 + off + pad, i
    if a.at is None:
        die("give --line N or --at TIME")
    t = parse_t(a.at)
    sp = a.span if a.span is not None else 12.0
    return t - sp / 2, t + sp / 2, None


