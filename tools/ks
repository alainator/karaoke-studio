          + (f"; dropped lines {r['dropped']}" if r.get("dropped") else "") + ("; players have the old version until it's published again" if job.get("published") else ""))


def cmd_video(a):
    """Add a custom video to a song (studio admins only, like the web app's Videos box): a link or a file; it replaces
    the official video or becomes a named version. Waits while the studio downloads, lines it up and renders it."""
    job = resolve(a.song)
    if bool(a.url) == bool(a.file):
        die("give --url or --file (one of them)")
    if a.mode == "version" and not a.name:
        die("a version needs --name (e.g. --name \"Mia's version\")")
    off = parse_t(a.offset) if a.offset not in (None, "") else None
    q = {"mode": a.mode, "name": a.name or "", "fill": "loop" if a.loop else "hold"}
    if a.url:
        call(f"/api/jobs/{job['id']}/videos", dict(q, url=a.url, offset=off))
    else:
        path = os.path.expanduser(a.file)
        if not os.path.isfile(path):
            die(f"no such file: {path}")
        qs = urllib.parse.urlencode(dict(q, offset="" if off is None else off, filename=os.path.basename(path)))
        size = os.path.getsize(path)
        print(f"uploading {os.path.basename(path)} ({size / 1e6:.0f} MB)...", flush=True)
        with open(path, "rb") as f:
            req = urllib.request.Request(f"{API}/api/jobs/{job['id']}/videos/upload?{qs}", data=f, method="PUT",
                                         headers=headers({"Content-Type": "application/octet-stream", "Content-Length": str(size)}))
            try:
                urllib.request.urlopen(req, timeout=3600).read()
            except urllib.error.HTTPError as e:
                try:
                    msg = json.loads(e.read()).get("detail")
                except Exception:
                    msg = e.reason
                die(f"upload: {e.code} {msg}")
            except urllib.error.URLError as e:
                die(f"the studio doesn't answer at {API} ({e.reason})")
    last = None
    while True:
        v = call(f"/api/jobs/{job['id']}/videos")
        t = v.get("task") or {}
        if t.get("running"):
            if t.get("text") != last:
                print(f"  {t.get('text')}...", flush=True)
                last = t.get("text")
            time.sleep(2)
            continue
        break
    if t.get("error"):
        die(f"couldn't make it: {t['error']}")
    key = "replace" if a.mode == "replace" else None
    items = [x for x in v.get("items", []) if (x["key"] == key if key else x.get("name") == a.name.strip())]
    x = items[0] if items else {}
    how = {"sound": f"lined up by sound, confidence {round(100 * (x.get('confidence') or 0))}%", "manual": "start set by hand",
           "none": f"NOT lined up ({x.get('reason')}): it starts with the song; nudge it in the web app or redo with --offset"}.get(x.get("aligned"), "?")
    print(("replaced the official video" if a.mode == "replace" else f"added the version '{a.name}'") + f": its start plays at {x.get('offset', 0):+.2f} s of the song ({how})"
          + (f"; the match drifts {x['drift']:+.2f} s over the song (other speed or an edit)" if x.get("drift") and abs(x["drift"]) > 0.3 else ""))
    if a.mode == "version" and x.get("publish_name"):
        print(f"  publishes (in the web app) as '{x['publish_name']}'")
    elif a.mode == "replace" and job.get("published"):
        print("  players have the official video until the song is published again")


def cmd_fill_orig(a):
    """Lines without their original-script row (added by hand) get it from a line with the same words."""
    job = resolve(a.song)

    def ch(lines, off):
        known = {text_of(l).lower(): l["orig"] for l in lines if l.get("orig")}
        n = 0
        for l in lines:
            if not l.get("orig") and known.get(text_of(l).lower()):
                l["orig"] = known[text_of(l).lower()]; n += 1
        missing = [l for l in lines if not l.get("orig")]
        m = 0
        if missing and any(l.get("orig") for l in lines):  # a song with original-script rows: look in its lyrics
            pairs = lyric_origs(job)
            key = lambda t: re.sub(r"[^a-z]", "", t.lower())
            for l in missing:
                k = key(text_of(l))
                best = max(pairs, key=lambda p: difflib.SequenceMatcher(None, k, key(p[1]), autojunk=False).ratio(), default=None)
                if best and k and difflib.SequenceMatcher(None, k, key(best[1]), autojunk=False).ratio() >= 0.8:
                    l["orig"] = best[0]; m += 1
        left = sum(1 for l in lines if not l.get("orig")) if m or n else len(missing)
        return (f"{n + m} line{'s' if n + m != 1 else ''} got their original-script row back"
                + (f" ({m} from the song's lyrics)" if m else "") + (f"; {left} still without one" if left else ""))
    edit(job, ch, "fill original-script rows")


