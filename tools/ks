def align_text(r):
    """ks align's answer as text (no lyrics beyond the song's own words, which ks show prints too)."""
    out = [f"aligned {fmt(r['window'][0])}-{fmt(r['window'][1])} together ({r['device']}, {r['seconds']} s):"]
    for x in r["lines"]:
        tag = " (the line asked for)" if x["line"] - 1 == r.get("target") else " (the line before)" if x["line"] - 1 == r.get("prev") else ""
        if x["at"] is None:
            out.append(f"{x['line']:3} now {fmt(x['now'])}: no word with letters to align{tag}")
            continue
        d = x["delta"]
        side = "same as now" if abs(d) < 0.1 else f"{abs(d):.1f} s {'earlier' if d < 0 else 'later'} than now"
        out.append(f"{x['line']:3} aligner {fmt(x['at'])}, {side}, confidence {x['conf']:.2f}{tag}")
        out.append("      " + "  ".join(f"{w['w']}@{fmt(w['at']) if w['at'] is not None else '-'}"
                                        f"({w['conf']:.2f})" if w['conf'] is not None else f"{w['w']}@-" for w in x["words"]))
    t = next((x for x in r["lines"] if x["line"] - 1 == r.get("target")), None)
    p = next((x for x in r["lines"] if x["line"] - 1 == r.get("prev")), None)
    if t is not None and t["at"] is not None:
        if p is not None and p["delta"] is not None and abs(p["delta"]) > 0.5:
            out.append(f"the line before moves too ({p['delta']:+.1f} s): the window is probably off (the line before isn't "
                       f"where it is now, or the singing there doesn't match the words); trust this less, look first")
        else:
            out.extend(boundary_text(t, p))
    return "\n".join(out + ["(evidence, not a fix: a second opinion. On lines people fixed it was right about 1 in 4 times "
                             "and it moves about 1 in 10 good lines, whatever its confidence. Trust it when the heard words "
                             "agree; ignore it on a chorus opener right after a held note, a duet reply, or a line whose "
                             "words repeat nearby (it often lands on the wrong copy))"])


def boundary_text(t, p):
    """The boundary between the line before and this one: where the aligner puts it vs now, and the pair edit. People
    fixing a late line usually also cut the line before's end (its held last note runs into this line's singing)."""
    n, y = t["line"], t["at"]
    out = []
    if p is not None and p.get("end") is not None:
        out.append(f"boundary: aligner {fmt(p['end'])} / {fmt(y)} (line {p['line']} ends, line {n} starts); now line "
                   f"{p['line']} ends {fmt(p['now_end'])}, line {n} starts {fmt(t['now'])}")
    d = t["delta"]
    if abs(d) < 0.3:
        out.append("the aligner agrees with where the line starts now (within 0.3 s)")
        return out
    if d > 0:
        out.append(f"the aligner starts it {d:.1f} s later: lines may light up early (up to 2.5 s), so leave it unless the "
                   f"picture shows its block starting on the line before's singing")
        return out
    cmds = []
    if p is not None and p["now_end"] > y - 0.05:   # the line before runs into this one's singing: cut it first
        cmds.append(f"ks stretch SONG {p['line']} --end {fmt(max(p['now'] + 0.2, y - 0.05))}")
    cmds.append(f"ks stretch SONG {n} --start {fmt(y)}")
    out.append(f"if the melody row or the heard words agree (ks look SONG --line {n} --align; ks heard SONG --line {n}): "
               + "; ".join(cmds))
    return out


