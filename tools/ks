def cmd_add(a):
    job = resolve(a.song)

    def ch(lines, off):
        s = parse_t(a.start) - off
        typed = typed_words(a.words)
        words = [w for w, _ in typed]
        if not words:
            die("give the words")
        e = parse_t(a.end) - off if a.end is not None else s + min(6.0, 0.45 * len(words) + 0.8)
        new = {"words": spread(words, s, e), "orig": None}
        for j, (_, pieces) in enumerate(typed):
            set_pieces(new, j, pieces)
