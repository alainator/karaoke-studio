    edit(job, ch, f"copy line {a.n}")


def lyric_origs(job):
    """(original line, its romaji) for every original-script line of the song's lyrics."""
    j = call(f"/api/jobs/{job['id']}")
    text = ""
    if j.get("lyrics_source") == "lrclib" and j.get("lrc_id"):
        x = lrclib(f"/api/get/{j['lrc_id']}") or {}
        text = x.get("syncedLyrics") or x.get("plainLyrics") or ""
    text = text or j.get("lyrics_text") or ""
    origs = []
    for line in text.splitlines():
        t = re.sub(r"\[[^\]]*\]", "", line).strip()
        if t and re.search(r"[\u3040-\u30ff\u3400-\u9fff\uac00-\ud7af]", t) and t not in origs:
            origs.append(t)
    if not origs:
        return []
    return list(zip(origs, call("/api/agent/romaji", {"lines": origs}, timeout=120)["romaji"]))


